{
  "hosting": {
    "site": "vet-ia",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/login"
      },
      {
        "source": "/cadastrar-pet",
        "destination": "/cadastrar-pet"
      },
      {
        "source": "/pet/**",
        "destination": "/pet"
      }
    ]
  }
}