
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores core information about a user profile.",
      "properties": {
        "id": { "type": "string" },
        "externalAuthUserId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "subscriptionPlan": { "type": "string", "enum": ["free", "premium", "pro"], "description": "Nível de assinatura do usuário." },
        "dailyUsageCount": { "type": "number", "description": "Contador de mensagens enviadas no dia atual." },
        "lastUsageDate": { "type": "string", "description": "Data da última interação para reset diário (YYYY-MM-DD)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "externalAuthUserId", "email", "displayName", "createdAt"]
    },
    "Pet": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Pet",
      "type": "object",
      "description": "Stores information about a user's pet.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "species": { "type": "string" },
        "breed": { "type": "string" },
        "age": { "type": "number" },
        "photoURL": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "species", "createdAt"]
    },
    "ChatMessage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ChatMessage",
      "type": "object",
      "description": "Represents a single message in a pet's chat history.",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "consultationRecommended": { "type": "boolean", "description": "Flag indicando se a IA sugeriu agendar uma consulta nesta resposta." },
        "isConsultationBooked": { "type": "boolean", "description": "Flag indicando se o agendamento sugerido já foi realizado pelo usuário." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "createdAt"]
    },
    "Consultation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Consultation",
      "type": "object",
      "description": "Represents a pet consultation entry.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "petId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "scheduled", "completed", "cancelled"] },
        "reason": { "type": "string" },
        "suggestedByAi": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "petId", "status", "createdAt"]
    },
    "AnalysisResult": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AnalysisResult",
      "type": "object",
      "description": "Stores the details and outcomes of an AI analysis.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "analysisType": { "type": "string" },
        "inputDescription": { "type": "string" },
        "aiResponse": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "analysisType", "inputDescription", "aiResponse", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile" }
      },
      {
        "path": "/users/{userId}/pets/{petId}",
        "definition": { "entityName": "Pet" }
      },
      {
        "path": "/users/{userId}/pets/{petId}/chatMessages/{messageId}",
        "definition": { "entityName": "ChatMessage" }
      },
      {
        "path": "/users/{userId}/pets/{petId}/consultations/{consultationId}",
        "definition": { "entityName": "Consultation" }
      },
      {
        "path": "/users/{userId}/analysisResults/{analysisResultId}",
        "definition": { "entityName": "AnalysisResult" }
      }
    ]
  }
}
