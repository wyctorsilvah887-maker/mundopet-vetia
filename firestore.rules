rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isOwner(userId);

      match /pets/{petId} {
        allow get, list, create, update, delete: if isOwner(userId);
        
        match /healthRecords/{recordId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        match /chatMessages/{messageId} {
          // Permite update para marcar isConsultationBooked como verdadeiro
          allow get, list, create, update: if isOwner(userId);
        }

        match /consultations/{consultationId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }
      }

      match /analysisResults/{analysisResultId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }
  }
}