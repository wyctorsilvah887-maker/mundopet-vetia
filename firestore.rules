
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isCreator() {
      // Verificação prioritária por e-mail e secundária por campo no documento
      return isSignedIn() && (
        request.auth.token.email == "wyctorsilvah887@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCreator == true)
      );
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        isCreator() || 
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewCount', 'totalRatingPoints']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'following', 'followers', 'coins', 'xpPoints', 'monthlyXp', 'lastChecklistDate', 'checklistStreak', 'checklistProgress', 'checklistProgressDate', 'checklistProcessedTasks', 'missionProgress', 'ownedItems', 'specialTitle', 'equippedAvatarFrameId', 'avatarFrameColor', 'equippedPostFrameId', 'postFrameColor', 'equippedPetFrames', 'petFrameColor'])
        )
      );
      allow create, delete: if isOwner(userId) || isCreator();

      match /pets/{petId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isOwner(userId) || isCreator();
        
        match /healthRecords/{recordId} {
          allow get, list: if isSignedIn();
          allow create, update, delete: if isOwner(userId) || isCreator();
        }

        // --- REGRAS DO CHAT DA VET IA ---
        match /chatMessages/{messageId} {
          allow get, list, create: if isOwner(userId) || isCreator();
        }
      }
      
      // Permitir listagem explícita para o histórico de análises
      match /analysisRequests/{analysisRequestId} {
        allow get, list, create, update, delete: if isOwner(userId) || isCreator();
      }

      match /commercial/{docId} {
        allow read: if true;
        allow write: if isOwner(userId) || isCreator();
      }

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn();
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write, create, update, delete: if isCreator();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.authorId) || 
        isCreator() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'commentCount']))
      );
      allow delete: if isSignedIn() && (isOwner(resource.data.authorId) || isCreator());

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow delete: if isSignedIn() && (isOwner(resource.data.authorId) || isCreator());
      }
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write, create, update, delete: if isCreator();
    }
    
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, write, update, delete: if isCreator();
    }
    
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete, update: if isCreator();
    }

    // --- REGRA PARA SISTEMA DE METADADOS (MARCAS E TAGS) ---
    match /metadata/{docId} {
      allow read: if true;
      allow write: if isCreator();
    }

    // --- REGRA PARA SISTEMA DE ANÚNCIOS ---
    match /ads/{adId} {
      allow read: if true;
      allow write, create, update, delete: if isCreator();
    }
  }
}
